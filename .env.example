# Sibill: creates invoice drafts only (the API route always sends issue=false).
# Keep the token server-side and never expose it with a NEXT_PUBLIC_ prefix.
SIBILL_API_TOKEN=
SIBILL_COMPANY_ID=
SIBILL_API_BASE_URL=https://integration.sibill.com
# Fatture Paradise: progressivo 83/001, 84/001... nel sezionale annuale /001.
# L'UUID è facoltativo se su Sibill esiste un solo sezionale /001 senza prefisso.
SIBILL_INVOICE_SECTIONAL_SUFFIX=/001
SIBILL_INVOICE_SECTIONAL_ID=
SIBILL_INVOICE_FIRST_PROGRESSIVE=83
# Per i pagamenti con carta viene cercato il conto Sibill il cui nome contiene 5597.
# Se conosci l'UUID del conto, SIBILL_CARD_ACCOUNT_ID ha la precedenza.
SIBILL_CARD_ACCOUNT_MATCH=5597
SIBILL_CARD_ACCOUNT_ID=
