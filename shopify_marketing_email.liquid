<!DOCTYPE html>
<html lang="it" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{ shop.name }} - Offerta Esclusiva Per Te</title>
  
  <!--[if gte mso 9]>
  <xml>
    <o:OfficeDocumentSettings>
      <o:AllowPNG/>
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml>
  <![endif]-->

  <style type="text/css">
    /* RESET STYLES */
    html, body {
      margin: 0 !important;
      padding: 0 !important;
      height: 100% !important;
      width: 100% !important;
      background-color: #f4f6f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    * {
      -ms-text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
      box-sizing: border-box;
    }
    table, td {
      mso-table-lspace: 0pt !important;
      mso-table-rspace: 0pt !important;
      border-collapse: collapse !important;
    }
    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
      display: block;
      max-width: 100%;
    }
    a {
      text-decoration: none;
      color: #2563eb;
    }

    /* RESPONSIVE STYLES */
    @media screen and (max-width: 600px) {
      .email-container {
        width: 100% !important;
        margin: auto !important;
      }
      .stack-column {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        direction: ltr !important;
      }
      .mobile-padding {
        padding-left: 20px !important;
        padding-right: 20px !important;
      }
      .hero-title {
        font-size: 26px !important;
        line-height: 32px !important;
      }
      .product-grid {
        width: 100% !important;
      }
    }
  </style>
</head>
<body width="100%" style="margin: 0; padding: 0 !important; mso-line-height-rule: exactly; background-color: #f4f6f9;">

  <!-- PREHEADER TEXT (Nascosto ma visibile nell'anteprima della casella di posta) -->
  <div style="display: none; font-size: 1px; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all; font-family: sans-serif;">
    Solo per te, {% if customer.first_name %}{{ customer.first_name }}{% else %}un regalo speciale{% endif %}: scopri la nuova collezione con il 20% di sconto!
  </div>

  <center style="width: 100%; background-color: #f4f6f9;">
    <!-- CONTAINER PRINCIPALE -->
    <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" class="email-container" style="margin: auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05); margin-top: 20px; margin-bottom: 20px;">
      
      <!-- HEADER / LOGO -->
      <tr>
        <td style="padding: 30px 40px; text-align: center; background-color: #ffffff; border-bottom: 1px solid #f0f0f0;">
          <a href="{{ shop.url }}" target="_blank">
            {% if shop.brand.logo %}
              <img src="{{ shop.brand.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="160" style="margin: auto; display: block;" />
            {% else %}
              <span style="font-size: 24px; font-weight: 800; color: #111827; letter-spacing: -0.5px; text-transform: uppercase;">
                {{ shop.name }}
              </span>
            {% endif %}
          </a>
        </td>
      </tr>

      <!-- HERO SECTION -->
      <tr>
        <td style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); padding: 50px 40px; text-align: center;" class="mobile-padding">
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
            <tr>
              <td style="text-align: center;">
                <span style="background-color: rgba(255, 255, 255, 0.15); color: #e0e7ff; padding: 6px 16px; border-radius: 50px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; display: inline-block; margin-bottom: 15px;">
                  Offerta Esclusiva VIP
                </span>
                <h1 class="hero-title" style="margin: 0 0 15px 0; color: #ffffff; font-size: 32px; font-weight: 800; line-height: 40px; letter-spacing: -0.5px;">
                  Ciao {% if customer.first_name %}{{ customer.first_name }}{% else %}Amico/a{% endif %},<br>
                  Il tuo stile merita il meglio.
                </h1>
                <p style="margin: 0 0 30px 0; color: #c7d2fe; font-size: 16px; line-height: 24px;">
                  Abbiamo riservato per te un codice sconto speciale per rinnovare i tuoi preferiti della nuova stagione.
                </p>

                <!-- BOTTONE CTA PRINCIPALE -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center">
                  <tr>
                    <td style="border-radius: 8px; background-color: #6366f1;">
                      <a href="{{ shop.url }}/collections/all" target="_blank" style="background-color: #6366f1; border: 1px solid #6366f1; font-family: sans-serif; font-size: 16px; font-weight: 700; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; display: inline-block;">
                        Scopri la Collezione &rarr;
                      </a>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>
          </table>
        </td>
      </tr>

      <!-- BOX CODICE PROMOZIONALE -->
      <tr>
        <td style="padding: 35px 40px; background-color: #fafafa; text-align: center; border-bottom: 1px solid #f0f0f0;" class="mobile-padding">
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
            <tr>
              <td style="border: 2px dashed #6366f1; background-color: #eef2ff; border-radius: 12px; padding: 20px; text-align: center;">
                <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 600; color: #4338ca; text-transform: uppercase; letter-spacing: 0.5px;">
                  Usa il Codice Sconto al Checkout
                </p>
                <div style="font-size: 26px; font-weight: 900; color: #1e1b4b; letter-spacing: 3px; margin-bottom: 6px;">
                  PROMO20
                </div>
                <p style="margin: 0; font-size: 13px; color: #6b7280;">
                  Valido per un periodo limitato sugli ordini superiori a 50€
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <!-- SEZIONE PRODOTTI IN EVIDENZA (LIQUID LOOP) -->
      <tr>
        <td style="padding: 40px 40px 20px 40px;" class="mobile-padding">
          <h2 style="margin: 0 0 25px 0; font-size: 22px; font-weight: 700; color: #111827; text-align: center; letter-spacing: -0.5px;">
            I Più Venduti del Momento
          </h2>

          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
            <tr>
              <!-- Esempio di loop Liquid su una collezione Shopify -->
              {% assign featured_collection = collections['frontpage'] | default: collections.all %}
              {% for product in featured_collection.products limit: 2 %}
              <td class="stack-column" width="50%" valign="top" style="padding: 0 10px 25px 10px;">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; background-color: #ffffff;">
                  <tr>
                    <td style="text-align: center; background-color: #f9fafb;">
                      <a href="{{ shop.url }}{{ product.url }}" target="_blank">
                        {% if product.featured_image %}
                          <img src="{{ product.featured_image | image_url: width: 400, height: 400, crop: 'center' }}" alt="{{ product.title }}" width="260" style="width: 100%; max-width: 260px; height: auto; display: block; margin: auto;" />
                        {% else %}
                          <div style="height: 200px; background-color: #e5e7eb; display: flex; align-items: center; justify-content: center; color: #9ca3af;">Foto Prodotto</div>
                        {% endif %}
                      </a>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 15px; text-align: center;">
                      <h3 style="margin: 0 0 8px 0; font-size: 15px; font-weight: 600; color: #111827; height: 38px; overflow: hidden;">
                        <a href="{{ shop.url }}{{ product.url }}" style="color: #111827; text-decoration: none;">
                          {{ product.title }}
                        </a>
                      </h3>
                      <div style="margin-bottom: 12px;">
                        {% if product.compare_at_price > product.price %}
                          <span style="font-size: 14px; color: #9ca3af; text-decoration: line-through; margin-right: 6px;">
                            {{ product.compare_at_price | money }}
                          </span>
                        {% endif %}
                        <span style="font-size: 16px; font-weight: 700; color: #4f46e5;">
                          {{ product.price | money }}
                        </span>
                      </div>
                      <a href="{{ shop.url }}{{ product.url }}" target="_blank" style="display: block; background-color: #f3f4f6; color: #1f2937; text-decoration: none; padding: 8px 12px; border-radius: 6px; font-size: 13px; font-weight: 600;">
                        Acquista Ora
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
              {% endfor %}
            </tr>
          </table>
        </td>
      </tr>

      <!-- BANNER VANTAGGI / TRUST BADGES -->
      <tr>
        <td style="padding: 25px 40px; background-color: #f9fafb; border-top: 1px solid #f0f0f0; border-bottom: 1px solid #f0f0f0;" class="mobile-padding">
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
            <tr>
              <td class="stack-column" width="33.33%" style="text-align: center; padding: 10px;">
                <div style="font-size: 20px; margin-bottom: 4px;">🚚</div>
                <div style="font-size: 13px; font-weight: 700; color: #111827;">Spedizione Rapida</div>
                <div style="font-size: 11px; color: #6b7280;">Gratis sopra i 50€</div>
              </td>
              <td class="stack-column" width="33.33%" style="text-align: center; padding: 10px;">
                <div style="font-size: 20px; margin-bottom: 4px;">🔄</div>
                <div style="font-size: 13px; font-weight: 700; color: #111827;">Reso Facile</div>
                <div style="font-size: 11px; color: #6b7280;">Entro 30 giorni</div>
              </td>
              <td class="stack-column" width="33.33%" style="text-align: center; padding: 10px;">
                <div style="font-size: 20px; margin-bottom: 4px;">🔒</div>
                <div style="font-size: 13px; font-weight: 700; color: #111827;">Pagamenti Sicuri</div>
                <div style="font-size: 11px; color: #6b7280;">Carta, PayPal, Klarna</div>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <!-- FOOTER -->
      <tr>
        <td style="padding: 35px 40px; background-color: #ffffff; text-align: center;" class="mobile-padding">
          <p style="margin: 0 0 15px 0; font-size: 14px; font-weight: 600; color: #374151;">
            Rimani in contatto con {{ shop.name }}
          </p>

          <!-- LINK SOCIAL -->
          <div style="margin-bottom: 20px;">
            <a href="{{ shop.url }}" style="display: inline-block; margin: 0 8px; color: #6b7280; font-size: 13px; font-weight: 500;">Sito Web</a> &bull;
            <a href="{{ shop.url }}/pages/contact" style="display: inline-block; margin: 0 8px; color: #6b7280; font-size: 13px; font-weight: 500;">Assistenza</a> &bull;
            <a href="{{ shop.url }}/collections/all" style="display: inline-block; margin: 0 8px; color: #6b7280; font-size: 13px; font-weight: 500;">Catalogo</a>
          </div>

          <p style="margin: 0 0 10px 0; font-size: 12px; color: #9ca3af; line-height: 18px;">
            Ricevi questa email perché sei iscritto alla newsletter di <strong>{{ shop.name }}</strong>.
          </p>

          <p style="margin: 0; font-size: 12px; color: #9ca3af;">
            {% if unsubscribe_link %}
              <a href="{{ unsubscribe_link }}" style="color: #6b7280; text-decoration: underline;">Disiscriviti dalla newsletter</a>
            {% else %}
              <a href="{{ shop.url }}" style="color: #6b7280; text-decoration: underline;">Gestisci le tue preferenze email</a>
            {% endif %}
          </p>

          <p style="margin: 15px 0 0 0; font-size: 11px; color: #d1d5db;">
            &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. Tutti i diritti riservati.
          </p>
        </td>
      </tr>

    </table>
  </center>

</body>
</html>
