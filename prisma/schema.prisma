generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  RESPONSABILE
  DIPENDENTE
}

enum DeviceStatus {
  ACTIVE
  BLOCKED
}

enum AttendanceType {
  ENTRATA
  PAUSA
  RIENTRO
  USCITA
}

enum LeaveType {
  FERIE
  PERMESSO
  RIPOSO
  MALATTIA
  ALTRO
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  password_hash     String
  role              UserRole         @default(DIPENDENTE)
  sede_id           String?
  pin_hash          String?
  pin_lookup        String?          @unique
  birth_date        DateTime?
  fiscal_code       String?
  contract_start    DateTime?
  contract_end      DateTime?
  photo_url         String?
  cover_url         String?
  whatsapp_phone    String?
  mansione          String?
  google_calendar_sync Boolean          @default(false)
  google_calendar_id   String?
  active            Boolean          @default(true)
  created_at        DateTime         @default(now())
  employee_status   String           @default("Attivo")
  manager_id        String?
  access_list       Json?
  hr_notes          String?
  candidate_id      String?
  header_color      String?
  sidebar_color     String?
  
  manager           User?            @relation("UserManager", fields: [manager_id], references: [id])
  subordinates      User[]           @relation("UserManager")
  
  location          Location?        @relation(fields: [sede_id], references: [id])
  attendance_logs   AttendanceLog[]
  leave_requests    LeaveRequest[]   @relation("UserLeaveRequests")
  approvals         LeaveRequest[]   @relation("LeaveApprover")
  documents         Document[]       @relation("UserDocuments")
  uploadedDocuments Document[]       @relation("DocumentUploader")
  notifications     Notification[]
  schedule_entries  ScheduleEntry[]
  schedule_overrides ScheduleWorkerOverride[]
  assigned_tasks    StaffTask[]      @relation("AssignedTasks")
  created_tasks     StaffTask[]      @relation("CreatedTasks")
  task_comments     StaffTaskComment[]
  work_hour_records WorkHourRecord[]
  created_service_forms ServiceForm[] @relation("CreatedServiceForms")
  service_form_responses ServiceFormResponse[]
  cash_closings    CashClosing[]
  cash_vault_withdrawals CashVaultWithdrawal[]
  cash_month_closings CashMonthClose[]
  social_posts      SocialPost[]     @relation("CreatedSocialPosts")
  social_post_comments SocialPostComment[]

  @@map("users")
}

model Location {
  id               String          @id @default(cuid())
  name             String
  address          String?
  phone            String?
  opening_time     String?
  closing_time     String?
  active           Boolean         @default(true)
  users            User[]
  devices          Device[]
  attendance_logs  AttendanceLog[]
  schedule_entries ScheduleEntry[]
  schedule_categories ScheduleCategory[]
  schedule_overrides ScheduleWorkerOverride[]
  staff_tasks        StaffTask[]
  service_form_responses ServiceFormResponse[]
  cash_closings      CashClosing[]
  cash_vault_withdrawals CashVaultWithdrawal[]

  @@map("locations")
}

model ScheduleCategory {
  id         String          @id @default(cuid())
  name       String
  code       String
  location_id String?
  color      String
  text_color String          @default("#1F1F1F")
  start_time String?
  end_time   String?
  editable_time Boolean        @default(false)
  paid_hours Float?
  active     Boolean         @default(true)
  created_at DateTime        @default(now())
  entries    ScheduleEntry[]
  location   Location?       @relation(fields: [location_id], references: [id])

  @@unique([code, location_id])
  @@map("schedule_categories")
}

model ScheduleEntry {
  id          String           @id @default(cuid())
  user_id     String
  location_id String?
  category_id String
  date        DateTime
  start_time  String?
  end_time    String?
  google_calendar_event_id String?
  note        String?
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  user        User             @relation(fields: [user_id], references: [id])
  location    Location?        @relation(fields: [location_id], references: [id])
  category    ScheduleCategory @relation(fields: [category_id], references: [id])

  @@unique([user_id, date])
  @@index([date])
  @@index([location_id, date])
  @@map("schedule_entries")
}

model ScheduleWorkerOverride {
  id          String   @id @default(cuid())
  location_id String
  user_id     String
  created_at  DateTime @default(now())
  location    Location @relation(fields: [location_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])

  @@unique([location_id, user_id])
  @@index([location_id])
  @@index([user_id])
  @@map("schedule_worker_overrides")
}

model StaffTask {
  id             String    @id @default(cuid())
  title          String
  description    String
  status         String    @default("NEW")
  priority       String    @default("MEDIA")
  category       String    @default("Operativa")
  checklist      Json?
  attachment_name String?
  attachment_url String?
  photo_url      String?
  link_url       String?
  notes          String?
  timer_seconds  Int       @default(0)
  completion_note String?
  completion_files Json?
  completion_links Json?
  evaluation String?
  evaluated_by_id String?
  evaluated_at DateTime?
  location_id    String
  created_by_id  String
  due_date       DateTime?
  started_at     DateTime?
  completed_at   DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  location       Location  @relation(fields: [location_id], references: [id])
  assignees      User[]    @relation("AssignedTasks")
  created_by     User      @relation("CreatedTasks", fields: [created_by_id], references: [id])
  comments       StaffTaskComment[]

  @@index([location_id])
  @@index([status])
  @@map("staff_tasks")
}

model StaffTaskComment {
  id         String    @id @default(cuid())
  task_id    String
  user_id    String
  message    String
  files      Json?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  task       StaffTask @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id])

  @@index([task_id])
  @@index([user_id])
  @@map("staff_task_comments")
}

model WorkHourRecord {
  id              String   @id @default(cuid())
  user_id         String
  date            DateTime
  hours           Float    @default(0)
  note            String?
  paid_break      Boolean  @default(false)
  manual_override Boolean  @default(false)
  updated_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  user            User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, date])
  @@index([date])
  @@map("work_hour_records")
}

model Device {
  id                    String          @id @default(cuid())
  device_id             String          @unique
  device_name           String
  location_id           String
  status                DeviceStatus    @default(ACTIVE)
  enrollment_token_hash String?
  access_token_hash     String?
  registered_ip         String?
  enrollment_expires_at DateTime?
  activated_at          DateTime?
  archived_at           DateTime?
  last_used_at          DateTime?
  created_at            DateTime        @default(now())
  location              Location        @relation(fields: [location_id], references: [id])
  attendance_logs       AttendanceLog[]

  @@map("devices")
}

model AttendanceLog {
  id          String         @id @default(cuid())
  user_id     String
  location_id String
  device_id   String
  type        AttendanceType
  timestamp   DateTime       @default(now())
  date        DateTime
  time        String
  ip_address  String?
  note        String?
  created_at  DateTime       @default(now())
  user        User           @relation(fields: [user_id], references: [id])
  location    Location       @relation(fields: [location_id], references: [id])
  device      Device         @relation(fields: [device_id], references: [id])

  @@index([user_id, date])
  @@index([location_id, date])
  @@map("attendance_logs")
}

model LeaveRequest {
  id          String        @id @default(cuid())
  user_id     String
  type        LeaveType
  start_date  DateTime
  end_date    DateTime
  start_time  String?
  end_time    String?
  reason      String?
  status      RequestStatus @default(PENDING)
  approved_by String?
  google_calendar_event_id String?
  created_at  DateTime      @default(now())
  user        User          @relation("UserLeaveRequests", fields: [user_id], references: [id])
  approver    User?         @relation("LeaveApprover", fields: [approved_by], references: [id])

  @@map("leave_requests")
}

model Document {
  id          String   @id @default(cuid())
  user_id     String
  title       String
  file_url    String
  storage_path String?
  type        String
  month       Int?
  year        Int?
  uploaded_by String
  created_at  DateTime @default(now())
  user        User     @relation("UserDocuments", fields: [user_id], references: [id])
  uploader    User     @relation("DocumentUploader", fields: [uploaded_by], references: [id])

  @@map("documents")
}

model Notification {
  id         String   @id @default(cuid())
  user_id    String
  title      String
  message    String
  type       String
  page       Int      @default(1)
  action_url String?
  read       Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@map("notifications")
}

model ServiceForm {
  id                   String                @id @default(cuid())
  name                 String
  description          String?
  category             String                @default("Generale")
  icon                 String                @default("FORM")
  active               Boolean               @default(true)
  allowed_roles        Json?
  allowed_location_ids Json?
  fields               Json
  notify_roles         Json?
  notify_user_ids      Json?
  created_by_id        String?
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt
  created_by           User?                 @relation("CreatedServiceForms", fields: [created_by_id], references: [id])
  responses            ServiceFormResponse[]

  @@index([active])
  @@map("service_forms")
}

model ServiceFormResponse {
  id                 String      @id @default(cuid())
  form_id            String
  user_id            String
  user_role          String
  user_location_id   String?
  user_location_name String?
  answers            Json
  status             String      @default("NEW")
  priority           String?
  assigned_to_id     String?
  internal_notes     Json?
  comments           Json?
  activity_log       Json?
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt
  form               ServiceForm @relation(fields: [form_id], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [user_id], references: [id])
  location           Location?   @relation(fields: [user_location_id], references: [id])

  @@index([form_id])
  @@index([user_id])
  @@index([status])
  @@index([user_location_id])
  @@map("service_form_responses")
}

model CashClosing {
  id             String   @id @default(cuid())
  user_id        String
  location_id    String
  date           DateTime
  withdrawn      Float
  fund           Float
  notes          String?
  signature_name String
  signature_role String?
  signed_at      DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  user           User     @relation(fields: [user_id], references: [id])
  location       Location @relation(fields: [location_id], references: [id])

  @@index([date])
  @@index([location_id, date])
  @@index([user_id])
  @@map("cash_closings")
}

model CashVaultWithdrawal {
  id             String   @id @default(cuid())
  user_id        String
  location_id    String
  date           DateTime
  amount         Float
  reason         String
  receipt_path   String?
  receipt_name   String?
  signature_name String
  signature_role String?
  signed_at      DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  user           User     @relation(fields: [user_id], references: [id])
  location       Location @relation(fields: [location_id], references: [id])

  @@index([date])
  @@index([location_id, date])
  @@index([user_id])
  @@map("cash_vault_withdrawals")
}

model CashMonthClose {
  id             String   @id @default(cuid())
  month          String   @unique
  closed_by_id   String
  closed_by_name String
  closed_by_role String?
  closed_at      DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  closed_by      User     @relation(fields: [closed_by_id], references: [id])

  @@map("cash_month_closings")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@map("settings")
}

model BrandingSetting {
  id               String  @id @default(cuid())
  primary_color    String  @default("#FFA8DD")
  secondary_color  String  @default("#FFD6EA")
  background_color String  @default("#F7E9EF")
  sidebar_color    String  @default("#FFFFFF")
  button_color     String  @default("#FFA8DD")
  card_color       String  @default("#FFFFFF")
  text_color       String  @default("#1F1F1F")
  gradient_color   String  @default("#E8C98B")
  dark_background_color String @default("#121114")
  dark_sidebar_color    String @default("#1B1A1F")
  dark_card_color       String @default("#201F24")
  dark_text_color       String @default("#F8F3F6")
  dark_button_color     String @default("#F4A3C4")
  sidebar_text_color    String @default("#1F1F1F")
  sidebar_icon_color    String @default("#1F1F1F")
  dark_sidebar_text_color String @default("#F8F3F6")
  dark_sidebar_icon_color String @default("#F8F3F6")
  logo_url         String?

  @@map("branding_settings")
}

model EmailSetting {
  id                String  @id @default(cuid())
  provider          String
  sender_email      String
  sender_name       String
  api_key_encrypted String?
  active            Boolean @default(false)

  @@map("email_settings")
}

model GoogleSheetSetting {
  id             String    @id @default(cuid())
  spreadsheet_id String
  sheet_name     String    @default("Timbrature")
  active         Boolean   @default(false)
  last_sync_at   DateTime?

  @@map("google_sheet_settings")
}

model Candidate {
  id                 String    @id @default(cuid())
  
  // Step 1: Base Info
  first_name         String
  last_name          String
  phone              String
  email              String
  birth_date         DateTime?
  profession         String
  city               String?
  availability       String
  preferred_location String
  experience         String
  cv_url             String?
  instagram_url      String?
  initial_notes      String?
  status             String    @default("Nuova candidatura")
  
  // Step 2: Videochiamata
  video_done               Boolean   @default(false)
  video_date               DateTime?
  video_interviewer_id     String?
  video_impression         Int?
  video_like               String?
  video_has_experience     String?
  video_prev_work          String?
  video_communication      String?
  video_motivation         String?
  video_notes              String?
  video_score              Int?
  
  // Step 3: Colloquio in sede
  interview_done           Boolean   @default(false)
  interview_date           DateTime?
  interview_location       String?
  interview_interviewer_id String?
  interview_presentation   String?
  interview_look_curato    Boolean?
  interview_communication  Int?
  interview_education      Int?
  interview_confidence     Int?
  interview_energy         Int?
  interview_practical_test Boolean?
  interview_notes          String?
  interview_score          Int?
  
  // Step 5: Giudizio finale & hiring status
  final_judgment           String?
  employee_created         Boolean   @default(false)
  created_user_id          String?
  
  video_calendar_event_id     String?
  interview_calendar_event_id String?
  
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  @@map("candidates")
}

model SocialPost {
  id                         String              @id @default(cuid())
  title                      String
  description                String?
  scheduled_at               DateTime
  platform                   String              // Memorizzato come stringa separata da virgole, es: "INSTAGRAM,TIKTOK"
  status                     String              @default("DRAFT") // "DRAFT", "PLANNED", "PUBLISHED"
  cover_url                  String?             
  video_url                  String?             
  notes                      String?
  brand                      String              @default("PARADISE") // "PARADISE" (Paradise Beauty) o "FRANCESCA" (Francesca)
  google_calendar_event_id   String?
  comments                   SocialPostComment[]
  created_by_id              String
  created_by                 User                @relation("CreatedSocialPosts", fields: [created_by_id], references: [id])
  created_at                 DateTime            @default(now())
  updated_at                 DateTime            @updatedAt

  @@map("social_posts")
}

model SocialPostComment {
  id            String      @id @default(cuid())
  post_id       String
  user_id       String
  message       String
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  post          SocialPost  @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [user_id], references: [id])

  @@map("social_post_comments")
}

model ShopifyOrderCache {
  order_id   String   @id
  order_name String
  created_at DateTime @default(now())

  @@map("shopify_order_cache")
}

model ShopifyOrderComment {
  id         String   @id @default(cuid())
  order_name String
  user_name  String
  user_role  String
  message    String
  created_at DateTime @default(now())

  @@index([order_name])
  @@map("shopify_order_comments")
}

